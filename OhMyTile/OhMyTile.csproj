<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OhMyTile</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseRidGraph>true</UseRidGraph>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- Microsoft.Windows.CsWinRT 已移除：TFM net10.0-windows10.0.19041.0 已内置 WinRT 投影，
         该包会强制调用 cswinrt.exe 并要求本机安装 Windows 10 SDK，导致无 SDK 的机器 / CI 无法编译 -->
  </ItemGroup>

  <ItemGroup>
    <None Update="Package.appxmanifest">
      <Link>AppxManifest.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>