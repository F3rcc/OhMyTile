<Window x:Class="OhMyTile.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="调整磁贴图片" Height="480" Width="360" WindowStartupLocation="CenterOwner" 
        Background="#111111" ResizeMode="NoResize" Topmost="True">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="拖动图片移动，滚轮/滑块缩放" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        
        <Canvas x:Name="CropCanvas" Width="300" Height="300" Background="Transparent" ClipToBounds="True" 
                MouseLeftButtonDown="Canvas_MouseDown" MouseLeftButtonUp="Canvas_MouseUp" 
                MouseMove="Canvas_MouseMove" MouseWheel="Canvas_MouseWheel">
            <!-- 使用 RenderTransformOrigin 确保缩放中心正确 -->
            <Image x:Name="DisplayImage" Stretch="Uniform" Width="300" Height="300" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ImageTransform"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Border BorderBrush="#88FFFFFF" BorderThickness="1" Width="300" Height="300" IsHitTestVisible="False"/>
        </Canvas>

        <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="5" Value="1" Margin="0,20" 
                ValueChanged="ScaleSlider_ValueChanged" Focusable="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="取消" Click="Cancel_Click" HorizontalAlignment="Left" Width="120" Height="35"/>
            <Button Grid.Column="1" Content="确定" Click="Ok_Click" 
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right" Width="120" Height="35"/>
        </Grid>
    </StackPanel>
</Window>