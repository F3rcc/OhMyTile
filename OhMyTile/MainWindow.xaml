<Window x:Class="OhMyTile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="OhMyTile - 磁贴实验室" Height="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ui:SimpleStackPanel Grid.Column="0" Margin="20" Spacing="10">
            <TextBlock Text="磁贴名称"/>
            <TextBox x:Name="TileNameInput" Text="我的漂亮磁贴"/>

            <TextBlock Text="背景颜色 (HEX)"/>
            <TextBox x:Name="BgColorInput" Text="#FF0078D7"/>

            <Button Content="选择图片" Click="SelectImage_Click" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
            <Button Content="固定到开始菜单" Click="CreateTile_Click" 
                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40"/>
        </ui:SimpleStackPanel>

        <Grid Grid.Column="1" Background="#F3F3F3">
            <Border x:Name="TilePreview" Width="150" Height="150" Background="#FF0078D7" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Image x:Name="ImagePreview" Stretch="UniformToFill"/>
                    <TextBlock Text="{Binding ElementName=TileNameInput, Path=Text}" Foreground="White" VerticalAlignment="Bottom" Margin="5"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>