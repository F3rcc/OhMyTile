<Window x:Class="OhMyTile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="OhMyTile" Height="768" Width="768">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ui:SimpleStackPanel Margin="10" Spacing="10">
        <TextBlock Text="第一步：选择目标" FontWeight="Bold" FontSize="16"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetPathInput" 
                    ui:ControlHelper.PlaceholderText="文件路径、文件夹或 URL" 
                    TextChanged="TargetPathInput_TextChanged"/>
            <Button Grid.Column="1" Content="文件" Click="SelectFile_Click" Margin="5,0"/>
            <Button Grid.Column="2" Content="文件夹" Click="SelectFolder_Click"/>
        </Grid>

        <TextBlock Text="第二步：自定义外观" FontWeight="Bold" FontSize="16" Margin="0,10,0,0"/>
        <TextBlock Text="磁贴显示名称"/>
        <TextBox x:Name="TileNameInput" Text="我的快捷方式"/>

        <!-- 第二步：自定义外观 内部 -->
        <TextBlock Text="背景颜色设置" FontWeight="Bold" FontSize="16" Margin="0,10,0,0"/>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BgColorInput" 
                    Text="#FF0078D7" 
                    VerticalAlignment="Center" 
                    TextChanged="BgColorInput_TextChanged" 
                    MaxLength="9"
                    InputMethod.IsInputMethodEnabled="False"/>
            <!-- 全局吸色按钮 -->
            <Button Grid.Column="1" Click="StartEyeDropper_Click" Margin="5,0,0,0" ToolTip="从屏幕吸色">
                <ui:SymbolIcon Symbol="Target"/>
            </Button>
        </Grid>

        <!-- SAI 风格配色板 -->
        <!-- SAI 风格配色板 -->
        <Viewbox Width="200" Height="200" HorizontalAlignment="Center" Margin="0,10">
            <Grid HorizontalAlignment="Center" Margin="0,10" Width="200" Height="200">
                <Image x:Name="ColorWheelImg" Stretch="None" 
                    MouseLeftButtonDown="ColorWheel_MouseDown" 
                    MouseMove="ColorWheel_MouseMove"
                    MouseLeftButtonUp="ColorWheel_MouseUp" 
                    Cursor="Hand"/>
                
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="HueSelector" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <Grid Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="SVPad_MouseDown" 
                    MouseMove="SVPad_MouseMove" 
                    MouseLeftButtonUp="SVPad_MouseUp"
                    Cursor="Cross">
                    <Rectangle x:Name="HueBackground" Fill="Blue"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="SVSelector" Width="10" Height="10" Stroke="White" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- <Button Content="自定义磁贴图标/图片" Click="SelectImage_Click" HorizontalAlignment="Stretch" Margin="0,10,0,0"/> -->
        <TextBlock Text="磁贴图标预览" Margin="0,10,0,0"/>
        <TextBlock Text="图标缩放比例 (%)" Margin="0,10,0,0"/>
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 缩放拖动条：10% - 100% -->
            <Slider x:Name="IconScaleSlider" Minimum="10" Maximum="100" Value="33" 
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="IconScaleSlider_ValueChanged"/>
            <!-- 百分比输入框 -->
            <TextBox Grid.Column="1" x:Name="IconScaleInput" Text="33" 
                    Margin="5,0" TextAlignment="Center"
                    TextChanged="IconScaleInput_TextChanged"/>
            <!-- 重置到系统默认 (33%) -->
            <Button Grid.Column="2" Content="系统默认" Click="ResetScale_Click" 
                    ToolTip="还原到 Windows 10 默认比例 (33%)"/>
        </Grid>
        <Grid Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="选择自定义图片" Click="SelectImage_Click" HorizontalAlignment="Stretch"/>
            <!-- 新增：重置按钮 -->
            <Button Grid.Column="1" Content="重置" Click="ResetIcon_Click" Margin="5,0,0,0" ToolTip="恢复使用文件默认图标"/>
        </Grid>        
        <Separator Margin="0,10"/>
        
        <Button Content="固定到开始菜单" Click="CreateCustomLauncherTile_Click" 
                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40"/>
    </ui:SimpleStackPanel>

        <Grid Grid.Column="1" Background="#000000">
            <!-- 修改右侧预览部分 -->
            <Border x:Name="TilePreview" Width="150" Height="150" Background="#FF0078D7" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <!-- 核心：不要设置 Image 的 Width/Height 为 150，我们要动态控制它 -->
                    <Image x:Name="ImagePreview" 
                            Stretch="Uniform" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="Fant"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True" />
                    <TextBlock x:Name="PreviewLabel" Text="{Binding ElementName=TileNameInput, Path=Text}" 
                            Foreground="White" VerticalAlignment="Bottom" Margin="5" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>